#zores/zos/python
# Python Code Block
import sys

def calculate_stats(numbers):
    total = sum(numbers)
    avg = total / len(numbers) if numbers else 0
    return {"total": total, "average": avg}

result = calculate_stats([10, 20, 30])
print(f"Stats: {result}")
